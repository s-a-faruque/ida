---
permalink: "/portfolio-api/"
title: Portfolio
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <meta name="theme-color" content="#28292C">
  <link rel="shortcut icon" href="/img/favicon.ico" type="image/x-icon">
  <link rel="stylesheet" href="/css/plugins/bootstrap.min.css">
  <script src="https://kit.fontawesome.com/0a2f6f41c6.js" crossorigin="anonymous"></script>
  <link rel="stylesheet" href="/css/plugins/fancybox.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <title>IDA | {{ title }}</title>
</head>
<body>
  <div class="qrt-app">
    <div class="qrt-top-bar">
      <a href="/" class="qrt-logo qrt-cursor-color qrt-cursor-scale"><img src="/img/ida-logo.png" alt="IDA"></a>
      <div class="qrt-menu">
        <nav>
          <ul>
            <li><a href="/">Home</a></li>
            <li><a href="/about-us/">About</a></li>
            <li class="current-menu-item"><a href="/portfolio-api/">Portfolio</a></li>
            <li><a href="/contact/">Contact</a></li>
          </ul>
        </nav>
      </div>
      <div class="qrt-buttons">
        <div class="qrt-menu-btn qrt-cursor-color qrt-cursor-scale"><span></span></div>
        <div class="qrt-info-btn qrt-cursor-color qrt-cursor-scale"><span></span></div>
      </div>
    </div>

    <div id="qrt-dynamic-content" class="qrt-dynamic-content">
      <div class="qrt-content" id="qrt-scroll-content">
        <div class="qrt-content-frame">
          <main class="qrt-left">
            <header class="qrt-mb-40">
              <h1 class="qrt-white">{{ title }}</h1>
            </header>

            <div class="qrt-filter qrt-mb-40">
              <a href="#" data-filter="*" class="qrt-work-category qrt-current qrt-filter-icon qrt-cursor-color qrt-cursor-scale"><i class="fas fa-filter"></i>All Categories</a>
              {% for project in projects %}
                {% for category in project.categories %}
                  <a href="#" data-filter=".{{ category | lower | replace(' ', '-') }}" class="qrt-work-category qrt-cursor-color qrt-cursor-scale">{{ category }}</a>
                {% endfor %}
              {% endfor %}
            </div>

            <div class="qrt-masonry-grid qrt-mb-40">
              <div class="qrt-grid-sizer"></div>
              {% for project in projects %}
                {% if project.heroImage %}
                  <article class="qrt-masonry-grid-item qrt-masonry-grid-item-50 {% for category in project.categories %}{{ category | lower | replace(' ', '-') }} {% endfor %}">
                    <div class="qrt-work-item">
                      <a data-fancybox="works" href="{{ project.heroImage.url }}" class="qrt-cursor-scale qrt-work-cover-frame">
                        <img src="{{ project.heroImage.url }}" alt="{{ project.heroImage.alt or project.title }}">
                        <div class="qrt-item-zoom qrt-cursor-color"><i class="fas fa-expand"></i></div>
                        <div class="qrt-work-category"><span>{{ project.categories | join(', ') }}</span></div>
                      </a>
                      <div class="qrt-work-descr">
                        <h4 class="qrt-cursor-color qrt-white"><a href="/projects/{{ project.id }}/" class="qrt-anima-link">{{ project.title }}</a></h4>
                        <a href="/projects/{{ project.id }}/" class="qrt-cursor-scale qrt-work-more qrt-anima-link" aria-label="View {{ project.title }}"><i class="fas fa-arrow-right"></i></a>
                      </div>
                    </div>
                  </article>
                {% endif %}
              {% else %}
                <p class="qrt-white">No projects are available right now.</p>
              {% endfor %}
            </div>

            <div class="qrt-call-to-action">
              <h4>Do you have a project?</h4>
              <a class="qrt-btn qrt-btn-sm qrt-btn-color qrt-cursor-scale" href="/contact/"><span>Let's discuss</span></a>
            </div>
          </main>
          <div class="qrt-right"></div>
        </div>
      </div>
    </div>
  </div>

  <script src="/js/plugins/jquery.min.js"></script>
  <script src="/js/plugins/anime.min.js"></script>
  <script src="/js/plugins/isotope.min.js"></script>
  <script src="/js/plugins/fancybox.min.js"></script>
  <script src="/js/plugins/swup.min.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>
